# Kode akses dashboard internal KOZY (#/internal).
# Tanpa berkas .env, kodenya memakai bawaan "kozysukses".
#
# Catatan: KOZY berjalan sepenuhnya di peramban, jadi kode ini hanya menghalangi
# orang yang mengetik alamatnya langsung — bukan pengamanan sungguhan. Untuk itu
# datanya harus pindah ke server.
VITE_KOZY_PIN=kozysukses

# Alamat penerima data aktivitas. Kalau kosong, aktivitas hanya tersimpan di perangkat.
# VITE_ANALYTICS_URL=

# Backend lokal KOZY diproxy lewat localhost:5173/api.
VITE_API_URL=/api
