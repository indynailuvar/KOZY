// Deploy KOZY ke Cloudflare (situs statis, tanpa server).
// Cara deploy: npm run build, lalu npx wrangler deploy (dari folder web/).
{
  "name": "kozy",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "kozy.arjunadanendra.com", "custom_domain": true }]
}
